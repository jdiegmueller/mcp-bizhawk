{
  "name": "mcp-bizhawk",
  "version": "2026.7.22-jd",
  "description": "MCP server for BizHawk — drive NES/SNES/GB/GBC/GBA/Genesis/N64/PSX/Saturn and more through one Lua bridge",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-bizhawk": "dist/index.js"
  },
  "files": [
    "dist/",
    "lua/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs => fs.chmodSync('dist/index.js', 0o755))\"",
    "test": "npm run build && node --test 'tests/**/*.test.mjs'",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "daemon": "node dist/index.js",
    "prepare": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmang-dev/mcp-bizhawk.git"
  },
  "bugs": {
    "url": "https://github.com/dmang-dev/mcp-bizhawk/issues"
  },
  "homepage": "https://github.com/dmang-dev/mcp-bizhawk#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bizhawk",
    "emulator",
    "tas",
    "nes",
    "snes",
    "n64",
    "claude"
  ]
}
