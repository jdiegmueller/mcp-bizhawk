# mcp-bizhawk (JD build) — always-on streamable-HTTP MCP daemon for REMOTE Windows BizHawk.
#
# One daemon owns the single BizHawk TCP socket (:8766) and the serial command
# queue, and exposes a streamable-HTTP MCP endpoint (:8765/mcp) that any number
# of Claude Code sessions connect to concurrently. This replaces the old
# per-session stdio MCP process, so there is no longer a port fight between
# sessions and nothing to toggle per session.
#
# Install (user service — no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/bizhawk-daemon-windows.service ~/.config/systemd/user/
#   # edit WorkingDirectory below if the repo lives elsewhere
#   systemctl --user daemon-reload
#   systemctl --user enable --now bizhawk-daemon-windows
#   loginctl enable-linger "$USER"   # keep it running when you're not logged in
#
# Manage:
#   systemctl --user status  bizhawk-daemon-windows
#   systemctl --user restart bizhawk-daemon-windows   # after `npm run build` on a version bump
#   journalctl --user -u bizhawk-daemon-windows -f    # live logs (server writes to stderr)

[Unit]
Description=mcp-bizhawk (JD) streamable-HTTP MCP daemon (remote Windows BizHawk)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/8tb/jason/mcp-bizhawk_jd
# Absolute path to node. nvm's node lives under ~/.nvm and is NOT on the systemd
# user PATH, so `/usr/bin/env node` would fail with status=203/EXEC. Update this
# path after an nvm node upgrade (`which node`), or symlink a stable location.
ExecStart=/mnt/8tb/jason/.nvm/versions/node/v26.5.0/bin/node dist/index.js
Restart=on-failure
RestartSec=2
# BizHawk connects from another host, so the bridge listener binds all
# interfaces. NOTE: this exposes :8766 on the LAN with no auth — anyone who can
# reach this port can drive the emulator (one client at a time). Keep it behind
# a trusted network / firewall.
Environment=BIZHAWK_HOST=0.0.0.0
# The MCP HTTP endpoint stays on loopback (no auth) unless you deliberately
# expose it. Uncomment to override defaults:
# Environment=MCP_HTTP_HOST=127.0.0.1
# Environment=MCP_HTTP_PORT=8765
# Environment=BIZHAWK_PORT=8766
# Vision model for screenshot descriptions (nhl94_state describe, bizhawk_screenshot describe)
Environment=VISION_BASE_URL=https://llama-swap.nevosi.com/v1
Environment=VISION_MODEL=Qwen3.6-35B-A3B
Environment=VISION_API_KEY=sk-no-key-required
# Cross-filesystem screenshots: this REMOTE Windows BizHawk cannot write the
# server's Linux /tmp, and the server cannot read a Windows path — so auto
# (no-`path`) screenshots (incl. the default-on vision caption) must land in a
# dir BOTH sides can reach via the shared mount. Here X:\ (Windows) == the
# server's /mnt/8tb/jason (Linux): the server writes/reads .../tmp, BizHawk is
# told X:\tmp. The dir must exist (the server creates the SHOT_DIR side).
# NOTE: the backslash MUST be doubled — systemd Environment= does C-style escape
# processing, so a lone `\t` becomes a TAB and BizHawk gets an invalid path.
Environment=MCP_BIZHAWK_SHOT_DIR=/mnt/8tb/jason/tmp
Environment=MCP_BIZHAWK_SHOT_DIR_BRIDGE=X:\\tmp

[Install]
WantedBy=default.target