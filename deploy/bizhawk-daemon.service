# mcp-bizhawk (JD build) — always-on streamable-HTTP MCP daemon.
#
# One daemon owns the single BizHawk TCP socket (:8766) and the serial command
# queue, and exposes a streamable-HTTP MCP endpoint (:8765/mcp) that any number
# of Claude Code sessions connect to concurrently. This replaces the old
# per-session stdio MCP process, so there is no longer a port fight between
# sessions and nothing to toggle per session.
#
# Install (user service — no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/bizhawk-daemon.service ~/.config/systemd/user/
#   # edit WorkingDirectory below if the repo lives elsewhere
#   systemctl --user daemon-reload
#   systemctl --user enable --now bizhawk-daemon
#   loginctl enable-linger "$USER"   # keep it running when you're not logged in
#
# Manage:
#   systemctl --user status  bizhawk-daemon
#   systemctl --user restart bizhawk-daemon   # after `npm run build` on a version bump
#   journalctl --user -u bizhawk-daemon -f    # live logs (server writes to stderr)

[Unit]
Description=mcp-bizhawk (JD) streamable-HTTP MCP daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/8tb/jason/mcp-bizhawk_jd
# Absolute path to node. nvm's node lives under ~/.nvm and is NOT on the systemd
# user PATH, so `/usr/bin/env node` would fail with status=203/EXEC. Update this
# path after an nvm node upgrade (`which node`), or symlink a stable location.
ExecStart=/mnt/8tb/jason/.nvm/versions/node/v26.5.0/bin/node dist/index.js
Restart=on-failure
RestartSec=2
# BizHawk connects from another host, so the bridge listener binds all
# interfaces. NOTE: this exposes :8766 on the LAN with no auth — anyone who can
# reach this port can drive the emulator (one client at a time). Keep it behind
# a trusted network / firewall.
Environment=BIZHAWK_HOST=0.0.0.0
# The MCP HTTP endpoint stays on loopback (no auth) unless you deliberately
# expose it. Uncomment to override defaults:
# Environment=MCP_HTTP_HOST=127.0.0.1
# Environment=MCP_HTTP_PORT=8765
# Environment=BIZHAWK_PORT=8766

[Install]
WantedBy=default.target
