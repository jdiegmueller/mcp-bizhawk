[Unit]
Description=mcp-bizhawk multiplexer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MCP_BIZHAWK_CONFIG=/mnt/8tb/jason/mcp-bizhawk_jd/backends.json
Environment=MCP_HTTP_HOST=10.245.0.226
Environment=MCP_HTTP_PORT=8765
Environment=WEB_HTTP_HOST=10.245.0.226
Environment=WEB_HTTP_PORT=8767
Environment=NODE_ENV=production
# nvm node is NOT on the systemd user PATH by default — use the full path
ExecStart=/mnt/8tb/jason/.nvm/versions/node/v26.5.0/bin/node /mnt/8tb/jason/mcp-bizhawk_jd/dist/index.js
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-bizhawk

[Install]
WantedBy=default.target
