# mcp-bizhawk (JD build) — SECOND always-on daemon, for a LOCAL Linux BizHawk.
#
# Sibling of bizhawk-daemon.service. Same code (dist/index.js), different ports
# so the two daemons don't collide:
#
#             MCP HTTP endpoint      BizHawk (Lua bridge) listener   MCP server name
#   windows   127.0.0.1:8765/mcp     0.0.0.0:8766 (remote Windows)   bizhawk_windows
#   linux     127.0.0.1:8763/mcp     127.0.0.1:8764 (local Linux)    bizhawk_linux
#
# The Linux BizHawk runs on THIS host, so both listeners stay on loopback — no
# LAN exposure (unlike the windows unit, which binds BizHawk to 0.0.0.0 for the
# remote emulator). Launch the emulator against it with, e.g.:
#   ./run_bizhawk_claude.sh --socket_port=8764
#
# Install (user service — no root needed):
#   cp deploy/bizhawk-daemon-linux.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now bizhawk-daemon-linux
#
# Manage:
#   systemctl --user status  bizhawk-daemon-linux
#   systemctl --user restart bizhawk-daemon-linux   # after `npm run build`
#   journalctl --user -u bizhawk-daemon-linux -f

[Unit]
Description=mcp-bizhawk (JD) streamable-HTTP MCP daemon (local Linux BizHawk)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/8tb/jason/mcp-bizhawk_jd
# Absolute path to node — see the note in bizhawk-daemon.service (nvm's node is
# not on the systemd user PATH; update after an nvm node upgrade).
ExecStart=/mnt/8tb/jason/.nvm/versions/node/v26.5.0/bin/node dist/index.js
Restart=on-failure
RestartSec=2
# Both listeners on loopback — the Linux BizHawk is local, no remote access.
Environment=MCP_HTTP_HOST=127.0.0.1
Environment=MCP_HTTP_PORT=8763
Environment=BIZHAWK_HOST=127.0.0.1
Environment=BIZHAWK_PORT=8764

[Install]
WantedBy=default.target
